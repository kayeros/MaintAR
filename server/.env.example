# Скопируйте в server/.env и заполните. Файл .env в git не попадает.

# Провайдер модели: auto | ollama | openai | anthropic
# auto: если задан ANTHROPIC_API_KEY — Anthropic, если OPENAI_API_KEY и OPENAI_MODEL — OpenAI-совместимый API, иначе Ollama.
PROVIDER=auto

# Локальная модель через Ollama (ключ не нужен): установите Ollama и выполните `ollama pull qwen2.5vl:7b`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Любой OpenAI-совместимый API (OpenRouter, OpenAI и т. п.)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Таймаут запроса к модели, секунды; максимальная сторона фото, пиксели; порог уверенности
TIMEOUT=120
MAX_SIDE=1280
MIN_CONFIDENCE=0.4
